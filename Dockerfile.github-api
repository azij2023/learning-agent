FROM python:3.11-slim

WORKDIR /app

COPY requirements.github-api.txt ./
RUN pip install --no-cache-dir -r requirements.github-api.txt

COPY api.py ./
COPY src/ ./src/

ENV LEARNING_AGENT_CORS_ORIGINS=https://azij2023.github.io

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
